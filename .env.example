# Discord Bot Configuration
# Get your bot token from: https://discord.com/developers/applications
TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
APPLICATION_ID=YOUR_APPLICATION_ID_HERE

# Logging Configuration
# Options: error, warn, info, debug (default: info)
LOG_LEVEL=info

# Controls console log formatting. Set to 'true' for pretty-printed metadata (indented multiline JSON).
PRETTY_LOGS=false

# Guild Restriction (Optional)
# Restrict which guilds the bot creates instances for.
# Can be comma-separated IDs or JSON array format.
# If not set, the bot loads all guilds.
# Examples:
#   GUILD_IDS=123456789012345678,987654321098765432
#   GUILD_IDS="[\"123456789012345678\",\"987654321098765432\"]"
GUILD_IDS=